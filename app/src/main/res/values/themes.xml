<resources>

    <style name="Base.Theme.JelajahJateng" parent="Theme.Material3.Light.NoActionBar">

        <!-- Hijau tua sebagai warna utama, emas sebagai aksen -->
        <item name="colorPrimary">@color/hijau_hutan</item>
        <item name="colorOnPrimary">@color/emas</item>
        <item name="colorSecondary">@color/emas</item>
        <item name="colorOnSecondary">@color/hijau_malam</item>

        <!-- Latar halaman dan kartu -->
        <item name="android:colorBackground">@color/krem</item>
        <item name="colorSurface">@color/putih</item>
        <item name="colorOnSurface">@color/teks_utama</item>
        <item name="colorOutline">@color/garis</item>

        <!-- Latar indikator menu bawah yang sedang aktif -->
        <item name="colorSecondaryContainer">@color/emas_muda</item>
        <item name="colorOnSecondaryContainer">@color/hijau_hutan</item>

        <!-- Halaman berlatar terang, jadi ikon status bar dibuat gelap -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

    </style>

    <style name="Theme.JelajahJateng" parent="Base.Theme.JelajahJateng" />

    <!-- Splash berlatar hijau gelap, jadi ikon status bar dibuat terang -->
    <style name="Theme.JelajahJateng.Splash" parent="Base.Theme.JelajahJateng">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

</resources>
