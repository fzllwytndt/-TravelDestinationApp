<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem">

    <!-- Baris Atas Header -->
    <LinearLayout
        android:id="@+id/headerEdit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnKembali"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tombol_bulat"
            android:contentDescription="Kembali"
            android:src="@drawable/ic_kembali" />

        <TextView
            android:id="@+id/tvJudulHalaman"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/judul_edit_wisata"
            android:textColor="@color/teks_utama"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/svForm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btnSimpan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerEdit">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Field Nama Wisata -->
            <EditText
                android:id="@+id/etNamaWisata"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pencarian"
                android:hint="Nama Tempat Wisata"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/teks_utama"
                android:textColorHint="@color/teks_kedua"
                android:textSize="14sp" />

            <!-- Field Kategori -->
            <EditText
                android:id="@+id/etKategori"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pencarian"
                android:hint="Kategori (misal: Alam, Sejarah, Kuliner)"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/teks_utama"
                android:textColorHint="@color/teks_kedua"
                android:textSize="14sp" />

            <!-- Field Lokasi -->
            <EditText
                android:id="@+id/etLokasi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pencarian"
                android:hint="Lokasi / Alamat"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/teks_utama"
                android:textColorHint="@color/teks_kedua"
                android:textSize="14sp" />

            <!-- Field Harga Tiket -->
            <EditText
                android:id="@+id/etHargaTiket"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pencarian"
                android:hint="Harga Tiket (Rp)"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/teks_utama"
                android:textColorHint="@color/teks_kedua"
                android:textSize="14sp" />

            <!-- Field URL Gambar / Foto Wisata -->
            <EditText
                android:id="@+id/etFoto"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pencarian"
                android:hint="URL Gambar / Foto Wisata"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/teks_utama"
                android:textColorHint="@color/teks_kedua"
                android:textSize="14sp" />

            <!-- Field Deskripsi Wisata -->
            <EditText
                android:id="@+id/etDeskripsi"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_pencarian"
                android:gravity="top|start"
                android:hint="Deskripsi Wisata"
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="@color/teks_utama"
                android:textColorHint="@color/teks_kedua"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/biru_tombol"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimpan"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/simpan_perubahan"
        android:textAllCaps="false"
        android:textColor="@color/putih"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/biru_tombol"
        app:cornerRadius="27dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
